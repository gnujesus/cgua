@get("api/users")
Response getUsers(Request req) {
    return Response::ok(db.all<User>());
}

@post("api/users")
Response createUser(Request req) {
    auto body = req.json<User>();
    db.insert(body);
    return Response::created();
}

@get("api/users/:id")
Response getUserById(Request req) {
    auto id = req.param("id");
    return Response::ok(db.find<User>(id));
}

@put("api/users/:id")
Response updateUser(Request req) {
    auto id   = req.param("id");
    auto body = req.json<User>();
    db.update<User>(id, body);
    return Response::ok();
}

@delete("api/users/:id")
Response deleteUser(Request req) {
    auto id = req.param("id");
    db.remove<User>(id);
    return Response::noContent();
}

@get("health")
Response healthCheck(Request req) {
    return Response::ok("OK");
}

@post("api/auth/login")
Response login(Request req) {
    auto creds = req.json<Credentials>();
    auto token = auth.login(creds);
    return Response::ok(token);
}

@post("api/auth/logout")
Response logout(Request req) {
    auth.invalidate(req.header("Authorization"));
    return Response::noContent();
}
